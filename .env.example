# Change this to something strong before deploying
ADMIN_PASSWORD=admin

# Upstash Redis - required for persistent storage on Vercel
# 1. Sign up free at console.upstash.com
# 2. Create a Redis database
# 3. Copy the REST URL and token from the "REST API" section
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# OpenAI API Key - optional, enables AI chat in the dashboard
# Get one at https://platform.openai.com/api-keys
# Everything works without it — the local analytics engine runs fully.
# Only the conversational AI chat needs this key.
OPENAI_API_KEY=sk-your_key_here
