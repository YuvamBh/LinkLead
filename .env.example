# LinkLead Environment Variables

# ---------------------------------------------------------
# Supabase (Primary Database & Auth)
# ---------------------------------------------------------
# 1. Create a project at supabase.com
# 2. Get these from Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------
# Upstash Redis (Caching Layer)
# ---------------------------------------------------------
# 1. Create a Redis DB at console.upstash.com
# 2. Get these from the "REST API" section
# Note: The app will gracefully degrade and skip caching if these are missing.
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ---------------------------------------------------------
# OpenAI (AI Analytics Console)
# ---------------------------------------------------------
# Optional: Enables AI chat in the dashboard.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here
